# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. Render app URL or Cloud Run URL)
APP_URL="http://localhost:3000"

# SUPABASE / POSTGRESQL DATABASE:
# Put your Supabase Postgres connection string here (from Supabase Project Settings -> Database -> Connection string -> URI)
DATABASE_URL="postgresql://postgres:your-password@db.your-supabase-project.supabase.co:5432/postgres"

# SUPABASE API (Optional, for auto bucket storage creation):
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# TELEGRAM BOTS CONFIGURATION:
# Create via @BotFather in Telegram
TELEGRAM_RIDER_BOT_TOKEN="your_rider_bot_token"
TELEGRAM_VENDOR_BOT_TOKEN="your_vendor_bot_token"

# RENDER 24/7 KEEP-ALIVE CONFIGURATION:
# Auto-ping target (defaults to APP_URL + /api/ping)
PING_INTERVAL_MS=300000

